# Cross Border Assistant — environment template.
# Copy to .env and fill in your own values. NEVER commit a real key.
# (.env is gitignored.)

# Real-time LLM (bring your own key). Leave empty for the deterministic engine.
CBA_LLM_ENABLED=0
CBA_LLM_API_KEY=
# CBA_LLM_BASE_URL=https://api.openai.com/v1
# CBA_LLM_MODEL=gpt-4o-mini
# CBA_LLM_TIMEOUT=30
# CBA_LLM_MAX_TOKENS=300

# Optional: local paths
# CBA_DB_PATH=./cba.db
# CBA_SMTP_HOST=
# CBA_SMTP_TO=
# CBA_WEBHOOK_URL=
